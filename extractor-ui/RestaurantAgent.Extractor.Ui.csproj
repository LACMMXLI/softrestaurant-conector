<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Nunca requiere administrador: es un cliente HTTP de solo lectura (más "sincronizar
         ahora") contra la API de control local del servicio, no toca la configuración
         protegida ni el propio servicio de Windows. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RestaurantAgent.Extractor.Ui</AssemblyName>
    <!-- Icono del .exe (barra de tareas, accesos directos, Explorador). TrayApplicationContext
         lo reutiliza en tiempo de ejecución para el ícono de la bandeja (Icon.ExtractAssociatedIcon
         sobre el propio ejecutable) — antes el NotifyIcon usaba SystemIcons.Application, el
         genérico de Windows. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
