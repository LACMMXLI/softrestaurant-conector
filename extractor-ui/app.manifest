<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="SoftRestaurant.Extractor.Ui" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker a propósito: la GUI corre con los permisos del usuario que inició
             sesión, sin pedir elevación. Solo consume la API HTTP local del servicio. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- El DPI awareness lo controla ApplicationHighDpiMode en el .csproj, no este manifiesto. -->
</assembly>
