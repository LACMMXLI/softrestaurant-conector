<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Nunca requiere administrador: es un cliente HTTP de solo lectura (más "sincronizar
         ahora") contra la API de control local del servicio, no toca la configuración
         protegida ni el propio servicio de Windows. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SoftRestaurant.Extractor.Ui</AssemblyName>
  </PropertyGroup>

</Project>
